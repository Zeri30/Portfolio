# Contact form email (https://resend.com). Copy to .env.local and fill in.
# Without these, the form logs messages to the console in development
# and shows a "please email me directly" message in production.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional. Must be an address on a domain you've verified in Resend.
# Defaults to Resend's test sender, which can only deliver to your own Resend account email.
CONTACT_FROM_EMAIL=
